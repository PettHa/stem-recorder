{
  "name": "stem-recorder-api",
  "version": "0.1.0",
  "author": "PettHa",
  "description": "TypeScript bindings for the stem-recorder Tauri plugin (mic + system audio loopback).",
  "keywords": [
    "audio-recording",
    "loopback",
    "wasapi",
    "tauri",
    "tauri-plugin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PettHa/stem-recorder.git"
  },
  "homepage": "https://github.com/PettHa/stem-recorder#readme",
  "bugs": "https://github.com/PettHa/stem-recorder/issues",
  "license": "MIT",
  "type": "module",
  "types": "./dist-js/index.d.ts",
  "main": "./dist-js/index.cjs",
  "module": "./dist-js/index.js",
  "exports": {
    "types": "./dist-js/index.d.ts",
    "import": "./dist-js/index.js",
    "require": "./dist-js/index.cjs"
  },
  "files": [
    "dist-js",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm build"
  },
  "dependencies": {
    "@tauri-apps/api": ">=2.0.0-beta.6"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.9.6",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
